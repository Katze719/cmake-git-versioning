#ifndef VERSION_H
#define VERSION_H
#pragma once

#ifdef __cplusplus
extern "C" {
#endif

// Version numbers
#define VERSION_MAJOR @GIT_VERSION_MAJOR@
#define VERSION_MINOR @GIT_VERSION_MINOR@
#define VERSION_PATCH @GIT_VERSION_PATCH@

// Pre-release information (empty string if not a pre-release)
#define VERSION_PRERELEASE "@GIT_VERSION_PRERELEASE@"
#define VERSION_PRERELEASE_TYPE "@GIT_VERSION_PRERELEASE_TYPE@"
#define VERSION_PRERELEASE_NUMBER "@GIT_VERSION_PRERELEASE_NUMBER@"

// Version string
#define VERSION_STRING "@GIT_DESCRIBE@"
#define VERSION_STRING_NO_V "@GIT_DESCRIBE_NO_V@"

// Git information
#define GIT_COMMIT_HASH_SHORT "@GIT_COMMIT_HASH_SHORT@"
#define GIT_COMMIT_HASH_FULL "@GIT_COMMIT_HASH_FULL@"
#define GIT_BRANCH "@GIT_BRANCH@"
#define GIT_COMMIT_DATE "@GIT_COMMIT_DATE@"

// Git describe components
#define GIT_TAG "@GIT_TAG@"
#define GIT_TAG_NO_V "@GIT_TAG_NO_V@"
#define GIT_COMMIT_COUNT @GIT_COMMIT_COUNT@
#define GIT_DESCRIBE_HASH "@GIT_DESCRIBE_HASH@"
#define GIT_IS_DIRTY @GIT_IS_DIRTY@
#define GIT_DIRTY_SUFFIX "@GIT_DIRTY_SUFFIX@"

#ifdef __cplusplus
}
#endif

#endif // VERSION_H
